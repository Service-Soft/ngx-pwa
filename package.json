{
    "name": "ngx-pwa",
    "version": "0.0.0",
    "scripts": {
        "start": "npm run stack",
        "stack": "run-s clear:dist stack:only",
        "stack:showcase": "run-s clear:dist stack:onlyShowcase",
        "showcase": "http-server dist/ngx-pwa-showcase --port=4200 --no-browser",
        "build:pwa": "ng build ngx-pwa-showcase --watch --configuration production",
        "api": "nodemon --watch api ./api/api.ts",
        "build:watch": "ng build ngx-pwa --watch",
        "lint": "eslint ./ --max-warnings 0",
        "lint:ci": "eslint ./ --max-warnings 0 --ignore-pattern '**/api.ts' --ignore-pattern '**/ngx-pwa-showcase/**/notification.service.ts'",
        "lint:fix": "eslint ./ --fix",
        "stack:only": "concurrently --kill-others 'npm run build:watch' 'run-s waitOn:build build:pwa' 'run-s waitOn:build api' 'run-s waitOn:build showcase'",
        "stack:onlyShowcase": "concurrently --kill-others 'npm run build:watch' 'run-s waitOn:build showcase'",
        "clear:dist": "run-s 'rimraf:ngxPwa' 'rimraf:ngxPwaShowcase'",
        "rimraf:ngxPwa": "rimraf dist/ngx-pwa",
        "rimraf:ngxPwaShowcase": "rimraf dist/ngx-pwa-showcase",
        "waitOn:build": "wait-on dist/ngx-pwa",
        "waitOn:buildPwa": "wait-on dist/ngx-pwa-showcase",
        "waitOn:server": "wait-on http://localhost:4200",
        "build": "ng build ngx-pwa",
        "build:prod": "run-s build copyToDist",
        "watch": "ng build --watch --configuration development",
        "copyToDist": "run-s copyToDist:readme copyToDist:contributing copyToDist:license",
        "copyToDist:readme": "ncp ./README.md ./dist/ngx-pwa/README.md",
        "copyToDist:contributing": "ncp ./CONTRIBUTING.md ./dist/ngx-pwa/CONTRIBUTING.md",
        "copyToDist:license": "ncp ./LICENSE.md ./dist/ngx-pwa/LICENSE.md"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^20.2.1",
        "@angular/cdk": "^20.2.0",
        "@angular/common": "^20.2.1",
        "@angular/compiler": "^20.2.1",
        "@angular/core": "^20.2.1",
        "@angular/forms": "^20.2.1",
        "@angular/material": "^20.2.0",
        "@angular/platform-browser": "^20.2.1",
        "@angular/platform-browser-dynamic": "^20.2.1",
        "@angular/router": "^20.2.1",
        "@angular/service-worker": "^20.2.1",
        "cors": "^2.8.5",
        "dompurify": "^3.2.6",
        "lodash": "^4.17.21",
        "ngx-material-navigation": "^20.0.0",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1",
        "uuid": "^11.1.0",
        "web-push": "^3.6.7",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^20.2.0",
        "@angular/cli": "~20.2.0",
        "@angular/compiler-cli": "^20.2.1",
        "@types/dompurify": "^3.2.0",
        "@types/lodash": "^4.17.20",
        "@types/uuid": "^10.0.0",
        "@types/web-push": "^3.6.4",
        "concurrently": "^9.2.0",
        "eslint-config-service-soft": "^2.0.8",
        "http-server": "^14.1.1",
        "ncp": "^2.0.0",
        "ng-packagr": "^20.2.0",
        "nodemon": "^3.1.10",
        "npm-run-all": "^4.1.5",
        "rimraf": "^6.0.1",
        "ts-node": "^10.9.2",
        "typescript": "~5.9",
        "wait-on": "^8.0.4"
    }
}